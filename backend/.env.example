# Copy this file to `.env` and fill in your credentials.
# Embeddings use OpenAI by default. Gemini is used for parsing + insights.

# Embedding provider: openai | gemini
EMBEDDING_PROVIDER=openai

# OpenAI embeddings (used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Creator data source (postgres recommended)
CREATOR_STORE=postgres
CREATORS_PATH=./data/creators.json

# PostgreSQL (used when CREATOR_STORE=postgres)
DATABASE_URL=postgresql://copilot:copilot@postgres:5432/creator_copilot
POSTGRES_CREATORS_TABLE=creators

# Cache settings (to reduce paid API usage)
# cache backend: sqlite | memory
CACHE_BACKEND=sqlite
CACHE_SQLITE_PATH=./data/cache.db
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_CACHE_VERSION=v4

GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Comma-separated list, or "*" for dev.
CORS_ORIGINS=*
