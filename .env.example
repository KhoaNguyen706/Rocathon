# Shared environment for docker-compose. Copy to `.env` at the repo root.

# Embedding provider (openai | gemini)
EMBEDDING_PROVIDER=openai

# OpenAI embeddings (used when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Creator store (postgres recommended)
CREATOR_STORE=postgres
CREATORS_PATH=./backend/data/creators.json

# PostgreSQL source
DATABASE_URL=postgresql://copilot:copilot@postgres:5432/creator_copilot
POSTGRES_CREATORS_TABLE=creators
POSTGRES_DB=creator_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot

# Cache controls
CACHE_BACKEND=sqlite
CACHE_SQLITE_PATH=./backend/data/cache.db
SEARCH_CACHE_TTL_SECONDS=1800
SEARCH_CACHE_VERSION=v4

# Gemini API (optional for parse + insights).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# CORS origins the backend will accept (comma-separated, or "*").
CORS_ORIGINS=*

# URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
